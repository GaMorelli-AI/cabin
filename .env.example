# ID do Agent criado no ElevenLabs (Conversational AI / Agents).
# Encontre em: https://elevenlabs.io/app/conversational-ai -> seu agent -> "Agent ID".
# Suficiente sozinho quando o agent está marcado como "Public" (sem autenticação).
VITE_ELEVENLABS_AGENT_ID=

# Opcional. Só necessário se o agent for PRIVADO.
# URL de uma rota/backend própria (ex.: a função em server/get-signed-url.js
# deste projeto) que devolve { "signedUrl": "..." } ou { "conversationToken": "..." }.
# Quando definido, VITE_ELEVENLABS_AGENT_ID acima é ignorado pelo frontend
# (o backend já sabe o agent ID, configurado como ELEVENLABS_AGENT_ID nele).
VITE_SIGNED_URL_ENDPOINT=
